{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "npm:libphonenumber-js@1.13.15/max": ["./node_modules/libphonenumber-js/max/index.d.ts"],
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js/dist/index.d.mts"]
    }
  },
  "include": ["src"]
}
